{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jwander-temp-storage",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "upload.jwander.net",
      "custom_domain": true,
    },
    {
      "pattern": "cdn.jwander.net",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "jwander-temp-storage",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jwander-temp-storage-db",
      "database_id": "0c560750-18b1-4997-8260-d60d5cd39694",
      "migrations_dir": "./migrations",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "DELETE_TOKEN_PEPPER",
      "IP_HASH_PEPPER",
      "ADMIN_TOKEN",
    ],
  },
  "vars": {
    "MAX_STORAGE_BYTES": "3221225472",
    "MAX_FILE_BYTES": "52428800",
    "FILE_RETENTION_SECONDS": "2592000",
    "RESERVATION_TTL_SECONDS": "900",
    "UPLOADS_ENABLED": "true",
    "UPLOAD_ORIGIN": "https://upload.jwander.net",
    "CDN_ORIGIN": "https://cdn.jwander.net",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD3nBLCS0pyrqnEn",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
